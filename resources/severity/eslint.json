    { "rule": "@typescript-eslint/no-unsafe-enum-comparison", "severity": "medium", "reason": "enum과 다른 값 비교" },

    { "rule": "no-unused-vars", "severity": "medium", "reason": "사용하지 않는 변수 — 오타·누락의 흔적일 수 있음(기준표 medium)" },
    { "rule": "@typescript-eslint/no-unused-vars", "severity": "medium", "reason": "사용하지 않는 변수(TS)" },
    { "rule": "no-unused-private-class-members", "severity": "medium", "reason": "사용하지 않는 private 멤버" },
    { "rule": "@typescript-eslint/no-unused-private-class-members", "severity": "medium", "reason": "사용하지 않는 private 멤버(TS)" },
    { "rule": "no-useless-assignment", "severity": "medium", "reason": "읽지 않고 덮어쓰는 대입" },
    { "rule": "no-use-before-define", "severity": "medium", "reason": "정의 전 사용(TDZ 오류 가능)" },
    { "rule": "@typescript-eslint/no-use-before-define", "severity": "medium", "reason": "정의 전 사용(TS)" },
    { "rule": "no-await-in-loop", "severity": "medium", "reason": "루프 안 await — 순차 실행으로 느림" },
    { "rule": "no-duplicate-imports", "severity": "low", "reason": "같은 모듈 중복 import" },
