    { "rule": "@typescript-eslint/explicit-module-boundary-types", "severity": "low", "reason": "모듈 경계 타입 명시(정책)" },
    { "rule": "@typescript-eslint/no-import-type-side-effects", "severity": "low", "reason": "타입 import 부수 효과(번들 크기)" },
