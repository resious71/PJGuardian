    { "rule": "no-nonoctal-decimal-escape", "severity": "medium", "reason": "\\8 \\9 이스케이프" },
    { "rule": "no-proto", "severity": "medium", "reason": "__proto__ 사용" },
    { "rule": "no-caller", "severity": "medium", "reason": "arguments.caller/callee — strict 모드 오류" },
    { "rule": "no-iterator", "severity": "low", "reason": "__iterator__ 사용(비표준)" },
    { "rule": "complexity", "severity": "medium", "reason": "순환 복잡도 초과(유지보수 위험)" },
    { "rule": "consistent-return", "severity": "medium", "reason": "값을 돌려주기도 안 돌려주기도 하는 함수" },
    { "rule": "@typescript-eslint/consistent-return", "severity": "medium", "reason": "값 반환 불일치(TS)" },
    { "rule": "require-yield", "severity": "medium", "reason": "yield 없는 제너레이터" },
    { "rule": "prefer-promise-reject-errors", "severity": "medium", "reason": "Error가 아닌 값으로 reject" },
    { "rule": "@typescript-eslint/prefer-promise-reject-errors", "severity": "medium", "reason": "Error가 아닌 값으로 reject(TS)" },
    { "rule": "@typescript-eslint/no-explicit-any", "severity": "medium", "reason": "any — 타입 검사를 무력화" },
