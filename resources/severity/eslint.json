{
  "tool": "eslint",
  "mapping_version": 1,
  "updated": "2026-10-05",
  "tool_versions": "ESLint 10.x + @typescript-eslint 8.x (규칙 카탈로그 eslint.catalog.json)",
  "note": "우선순위: rules(개별 규칙) > prefixes(접두사, 가장 긴 것) > defaults(카탈로그의 규칙 meta.type) > not_defined. 규칙 키는 'eslint:' 뒤의 이름. 기준은 docs/severity_mapping.md. 바꾸면 mapping_version을 올린다.",
  "defaults": [
    { "group": "problem", "severity": "high", "reason": "meta.type problem — 오류나 혼란을 일으킬 코드" },
    { "group": "suggestion", "severity": "low", "reason": "meta.type suggestion — 더 나은 작성 방법(동작에는 대개 영향 없음)" },
    { "group": "layout", "severity": "low", "reason": "meta.type layout — 공백·서식" }
  ],
  "prefixes": [],
  "rules": [
    { "rule": "syntax-error", "severity": "high", "reason": "파싱 실패(구문 오류) — 파일을 실행할 수 없다" },
    { "rule": "unused-disable-directive", "severity": "low", "reason": "쓰지 않는 eslint-disable 주석" },
    { "rule": "no-rule-id", "severity": "low", "reason": "규칙 없이 보고된 메시지(도구 안내)" },

    { "rule": "no-eval", "severity": "critical", "reason": "eval — 임의 코드 실행" },
    { "rule": "no-implied-eval", "severity": "critical", "reason": "문자열 setTimeout 등 암묵적 eval" },
    { "rule": "@typescript-eslint/no-implied-eval", "severity": "critical", "reason": "암묵적 eval(TS)" },
    { "rule": "no-new-func", "severity": "critical", "reason": "new Function — 임의 코드 실행" },
    { "rule": "no-script-url", "severity": "critical", "reason": "javascript: URL — XSS" },

    { "rule": "no-global-assign", "severity": "high", "reason": "전역 객체(undefined 등) 덮어쓰기" },
    { "rule": "no-shadow-restricted-names", "severity": "high", "reason": "NaN·undefined 등 예약 이름 가리기" },
    { "rule": "no-extend-native", "severity": "high", "reason": "내장 객체 프로토타입 확장 — 다른 코드와 충돌" },
    { "rule": "no-with", "severity": "high", "reason": "with 문 — strict 모드 구문 오류, 이름 해석 혼란" },
    { "rule": "no-redeclare", "severity": "medium", "reason": "같은 이름 다시 선언" },
    { "rule": "@typescript-eslint/no-redeclare", "severity": "medium", "reason": "같은 이름 다시 선언(TS)" },
    { "rule": "eqeqeq", "severity": "medium", "reason": "== 형 변환 비교" },
    { "rule": "no-empty", "severity": "medium", "reason": "빈 블록(예외 삼키기 포함)" },
    { "rule": "no-case-declarations", "severity": "medium", "reason": "case 안의 선언 — 다른 case로 새는 범위" },
    { "rule": "no-delete-var", "severity": "medium", "reason": "변수 delete" },
    { "rule": "no-new-wrappers", "severity": "medium", "reason": "new String 등 래퍼 객체" },
    { "rule": "no-throw-literal", "severity": "medium", "reason": "Error가 아닌 값 throw — 스택 없음" },
    { "rule": "@typescript-eslint/only-throw-error", "severity": "medium", "reason": "Error가 아닌 값 throw(TS)" },
    { "rule": "no-unused-expressions", "severity": "medium", "reason": "효과 없는 식 — 의도한 호출·대입 누락일 수 있음" },
    { "rule": "@typescript-eslint/no-unused-expressions", "severity": "medium", "reason": "효과 없는 식(TS)" },
    { "rule": "no-loop-func", "severity": "medium", "reason": "루프 안 함수가 루프 변수를 늦게 참조" },
    { "rule": "no-return-assign", "severity": "medium", "reason": "return 안의 대입(비교 오타일 수 있음)" },
    { "rule": "no-sequences", "severity": "medium", "reason": "쉼표 연산자(의도하지 않은 경우가 많음)" },
    { "rule": "no-implicit-globals", "severity": "medium", "reason": "암묵적 전역 선언" },
    { "rule": "no-invalid-this", "severity": "medium", "reason": "클래스 밖 this" },
    { "rule": "@typescript-eslint/no-invalid-this", "severity": "medium", "reason": "클래스 밖 this(TS)" },
    { "rule": "no-octal", "severity": "medium", "reason": "8진 리터럴 — strict 모드 오류" },
