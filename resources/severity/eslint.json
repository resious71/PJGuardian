    { "rule": "no-template-curly-in-string", "severity": "medium", "reason": "일반 문자열 안 ${} — 템플릿 문자열 오타" },
    { "rule": "require-atomic-updates", "severity": "medium", "reason": "await 사이 경쟁 조건 가능(오탐 많음)" },
