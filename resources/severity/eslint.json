    { "rule": "@typescript-eslint/no-unsafe-argument", "severity": "medium", "reason": "any를 인자로 전달" },
    { "rule": "@typescript-eslint/no-unsafe-assignment", "severity": "medium", "reason": "any 대입" },
    { "rule": "@typescript-eslint/no-unsafe-call", "severity": "medium", "reason": "any 호출" },
    { "rule": "@typescript-eslint/no-unsafe-member-access", "severity": "medium", "reason": "any 멤버 접근" },
    { "rule": "@typescript-eslint/no-unsafe-return", "severity": "medium", "reason": "any 반환" },
    { "rule": "@typescript-eslint/no-unsafe-type-assertion", "severity": "medium", "reason": "좁히는 타입 단언" },
    { "rule": "@typescript-eslint/no-unsafe-function-type", "severity": "medium", "reason": "Function 타입 — 인자·반환 검사 없음" },
    { "rule": "@typescript-eslint/no-unsafe-declaration-merging", "severity": "medium", "reason": "클래스·인터페이스 병합" },
    { "rule": "@typescript-eslint/no-wrapper-object-types", "severity": "medium", "reason": "String 등 래퍼 타입" },
    { "rule": "@typescript-eslint/parameter-properties", "severity": "low", "reason": "매개변수 속성 스타일" },
    { "rule": "@typescript-eslint/prefer-reduce-type-parameter", "severity": "low", "reason": "reduce 타입 매개변수 스타일" },
    { "rule": "@typescript-eslint/related-getter-setter-pairs", "severity": "medium", "reason": "getter·setter 타입 불일치" },
    { "rule": "@typescript-eslint/restrict-plus-operands", "severity": "medium", "reason": "형이 다른 + 연산" },
    { "rule": "@typescript-eslint/restrict-template-expressions", "severity": "medium", "reason": "템플릿 문자열의 의도하지 않은 형" },
    { "rule": "@typescript-eslint/return-await", "severity": "medium", "reason": "try 안 return await 누락 등" },
    { "rule": "@typescript-eslint/no-useless-constructor", "severity": "low", "reason": "쓸모없는 생성자" },
    { "rule": "@typescript-eslint/no-confusing-void-expression", "severity": "medium", "reason": "void 식을 값으로 사용" },
    { "rule": "@typescript-eslint/no-deprecated", "severity": "medium", "reason": "폐기된 API 사용" },
    { "rule": "@typescript-eslint/no-mixed-enums", "severity": "medium", "reason": "숫자·문자 섞인 enum" },
    { "rule": "@typescript-eslint/no-generated-empty-object-type", "severity": "low", "reason": "생성된 빈 객체 타입" },
    { "rule": "@typescript-eslint/strict-void-return", "severity": "medium", "reason": "void 반환 위치에 값 반환" },
    { "rule": "@typescript-eslint/no-non-null-asserted-nullish-coalescing", "severity": "medium", "reason": "?? 왼쪽의 ! 단언" },
    { "rule": "@typescript-eslint/no-extra-non-null-assertion", "severity": "low", "reason": "중복 ! 단언" },
    { "rule": "@typescript-eslint/no-confusing-non-null-assertion", "severity": "medium", "reason": "비교와 헷갈리는 ! 단언" },
