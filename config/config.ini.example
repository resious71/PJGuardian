; PJGuardian 설정 예시
; 이 파일을 config/config.ini로 복사해 사용한다. config.ini는 git에 커밋하지 않는다.
; 비밀번호·암호화 키는 이 파일에 쓰지 않는다 → config/secrets.example 참고 (명세 19.7)
; 시작할 때 모든 값의 범위와 형식을 검증하고, 오류가 있으면 기동을 거부한다 (명세 19.7)
;   점검: php tools/config_check.php
; 변경은 웹에는 즉시, 워커에는 재시작 후 적용된다 (명세 19.7)
; P27A: 일부 운영 값(허용 목록)은 관리자 "시스템 관리 > 설정 관리" 화면에서 바꿀 수 있다. 화면에서 바꾼 값은 이 파일이 아니라
;   같은 폴더의 settings.local.ini에 저장되고 이 파일보다 우선한다. 우선순위: 환경 변수 PJG_<섹션>_<키> > settings.local.ini > config.ini > 기본값.
;   화면 설정 값은 워커도 재시작 없이 몇 초 안에 다시 읽는다(docs/settings.md).
;
; 값 형식
;   크기   : 숫자 + 단위(B, KB, MB, GB, TB, 1024 기준). 예) 8MB, 2GB. 숫자만 쓰면 바이트
;   기간   : 숫자 + 단위(s, m, h, d, w). 예) 30m, 4h, 60d. 숫자만 쓰면 초
;   목록   : 쉼표로 구분
;   참/거짓: true / false
; 각 항목 주석의 "명세 X.Y"는 PJGuardian_requirements.md의 장·절 번호이다.
; "[가정]"은 명세 본문에 값이 없거나 부록 "확인 필요 항목"에서 가정한 값이다.
; 키를 추가하는 방법은 docs/architecture.md "설정 키 추가" 절을 따른다(src/Support/ConfigSchema.php에도 등록).

[app]
; 실행 환경: prod(운영, 기본) | dev(개발 전용 화면 /dev/styleguide를 열고, 미정의 아이콘 이름을 오류로 알림)
env = "prod"
; 화면 표시 시간대. DB에는 UTC로 저장 (명세 1)
display_timezone = "Asia/Seoul"
; 서비스 기준 주소. HTTP 요청은 이 주소의 HTTPS로 리다이렉트한다(Host 헤더를 믿지 않음) (명세 10)
; [가정] 개발 PC 기본값
base_url = "https://pjguardian.local"

[security]
; HTTPS 강제(명세 10: Apache 리다이렉트와 HSTS, 앱에서 이중 검사). 개발용으로만 false 허용
require_https = true
; HSTS max-age (명세 10) [가정] 1년
hsts_max_age = 365d
; 신뢰하는 리버스 프록시 주소(쉼표로 구분, IP 또는 CIDR, 명세 19.10 P10, P32B). 비우면(기본) 접속 주소만 쓰고 X-Forwarded-For·X-Forwarded-Proto를 믿지 않는다.
; 직접 접속 주소가 이 목록에 있을 때만 전달 헤더로 클라이언트 주소(로그인 시도 제한·감사 로그·/health 허용 IP)와 https 여부(HTTPS 강제·HSTS)를 정한다
trusted_proxies = ""

[maintenance]
; 업그레이드 유지보수 모드(명세 19.4, P32B). 화면: 시스템 관리 > 설정 관리 > 유지보수. 켜면 admin이 아닌 사용자의 쓰기·업로드는 503(읽기·로그인은 됨),
; 워커는 새 분석을 시작하지 않는다(진행 중인 것은 끝냄). 화면에서 켜는 순간 DB 백업(pre_upgrade, 스냅샷 제외)을 먼저 하고 실패하면 켜지 않는다
enabled = false
; 모든 사용자 화면 위 배너에 덧붙일 안내 문구(비우면 기본 문장만)
message = ""
; 사전 공지: 예정 시각(표시 시간대, YYYY-MM-DD HH:MM). 그 시각 전까지 모든 사용자 화면에 공지 배너, 지나면 저절로 사라짐
notice_at = ""
; 켜기 직전 백업을 기다리는 시간 상한 [가정] 10분(넘으면 켜지 않음 — 백업은 워커가 계속한다)
backup_wait = 10m

[paths]
; 프로젝트 루트 기준 상대 경로 또는 절대 경로. 모두 웹 루트(public/) 밖이어야 한다 (명세 2, 10)
; [가정] 경로 기본값은 P01 폴더 구조를 따른다
db_file = "data/db/pjguardian.sqlite"
uploads_dir = "data/uploads"
; 작업 디렉토리는 짧게 유지한다(명세 19.10: 최종 경로 259자 이하)
work_dir = "data/work"
snapshots_dir = "data/snapshots"
logs_dir = "data/logs"
bin_dir = "bin"
; P27B부터 백업 서비스는 이 값을 읽지 않는다 — 백업 위치는 [backup] dir(시스템 관리 > 설정 관리 > 백업 폴더). 예전 config.ini와 맞추려고 남겨 둔 키
backups_dir = "data/backups"

[database]
; SQLite 잠금 대기 시간(PRAGMA busy_timeout). 웹과 워커가 동시에 쓸 때 바로 실패하지 않고 기다린다 (명세 2, 19.7)
; [가정] 5초. 쓰기 트랜잭션은 짧게 유지한다(docs/architecture.md)
busy_timeout = 5s
; WAL 체크포인트(P20S): 분석 반영 연결은 자동 체크포인트를 끄고, 워커가 분석 사이에 PASSIVE 체크포인트를 한다.
; WAL 파일이 이 크기를 넘으면 워커가 한가할 때 TRUNCATE로 줄인다 [가정] 256MB. 웹 연결은 아래 web_wal_autocheckpoint, CLI의 다른 연결은 SQLite 기본 동작 그대로
wal_truncate_threshold = 256MB
; 체크포인트 순서(P19C): 분석 사이에 PASSIVE(다른 연결을 막지 않음)를 먼저 하고, 그 뒤에도 WAL 파일이 위 크기를 넘으면 TRUNCATE를 시도한다.
; TRUNCATE가 다른 연결의 쓰기를 막을 수 있는 시간 상한(ms) — 이 시간 안에 안 되면 포기하고 다음 기회에 [가정] 2000
checkpoint_max_block_ms = 2000
; 웹 요청 연결의 SQLite 자동 체크포인트(P31, 페이지 수, 0 = 끔). 켜 두면 큰 분석 반영 직후 다음 웹 요청 하나가 WAL 수백 MB를 혼자 옮기며
; 수십 초 걸릴 수 있다(측정 docs/performance.md). 끄면 체크포인트는 워커가 분석 사이와 한가할 때(아래 간격) 한다 — 워커가 멈춰 있으면 WAL이 자란다 [가정] 0
web_wal_autocheckpoint = 0
; 워커가 한가할 때도 PASSIVE 체크포인트를 하는 간격(P31, 웹 연결의 자동 체크포인트를 끈 만큼 워커가 맡음) 1m~1d [가정] 10m
idle_checkpoint_interval = 10m
; 분석 반영 연결(분석 자식 프로세스)의 SQLite 페이지 캐시 MB(P19C). 0이면 SQLite 기본(2MB). 결함 수십만 건 반영의 색인 갱신 시간을 줄인다
; (50만 건 측정: 신규 전체 쓰기 트랜잭션 14초 → 8초). PHP memory_limit과 별도로 분석 하나당 이만큼 RAM을 더 쓸 수 있다(동시 2개) [가정] 128
analysis_cache_mb = 128

[upload]
; zip 최대 크기 2GB (명세 5.1, 5.4, 10)
max_zip_size = 2GB
; 청크 크기 8MB (명세 5.4)
chunk_size = 8MB
; 완료되지 않은 업로드 조각 보관 24시간 (명세 5.4)
incomplete_chunk_retention = 24h
; 실패·취소된 분석의 zip 보관 1일 (명세 5.4, 14)
failed_zip_retention = 1d
; 사용자당 동시 진행 업로드 수(전송 중·조립 대기·조립 중·해제 대기, 확인 대기는 제외) (명세 19.10)
max_concurrent_per_user = 2
; 경고 확인 대기(needs_confirmation) 보관 시간. 지나면 취소하고 해제 결과를 지운다 [가정] 24시간 (P13)
confirmation_retention = 24h
; 사전 검사 대상 확장자 (명세 5.4)
target_extensions_python = ".py"
target_extensions_javascript = ".js,.jsx,.ts,.tsx"

[extract]
; 압축 해제 후 총량 10GB (명세 5.1, 10)
max_extracted_size = 10GB
; 압축 해제 후 파일 수 1,000,000개 (명세 5.1, 10)
max_files = 1000000
; 업로드 후처리(조립·해제) CLI 워커의 PHP memory_limit. 웹 요청과 따로 둔다 (명세 19.10)
; P13 실측(Windows): 항목 100만 개 해제에서 PHP 최대 172MB, 프로세스 전체 486MB(libzip 포함, memory_limit 밖) → 512MB(약 3배 여유)
worker_memory_limit = 512MB
; 서버 기본 제외 대상. 항상 적용되며 관리자가 프로젝트별로 추가할 수 있다 (명세 4, 5.1, 19.10)
default_excludes = "node_modules,.venv,venv,__pycache__,.git,dist,build,__MACOSX,.DS_Store"

[analysis]
; 분석 타임아웃 4시간. 초과 시 하위 프로세스까지 종료 (명세 5.2)
timeout = 4h
; 전체 동시 분석 수 2. 프로젝트당 1개 실행 규칙은 별도로 항상 적용 (명세 5.2, 5.4, 14, 19.8)
max_concurrent = 2
; 분석 프로세스 하나당 메모리 한도 8GB. Node는 메모리 옵션, ruff는 Linux prlimit (명세 19.1, 19.10)
process_memory_limit = 8GB
; 분석 도구 출력(JSON) 크기 한도 1GB (명세 19.1)
output_limit = 1GB
; 출력 한도 초과 여유. 분석 시작 전 디스크 여유가 output_limit + 이 값보다 적으면 분석하지 않는다(실패 insufficient_storage) (명세 19.3, P15)
; P14 실측(Windows): 최대 속도로 쓰는 출력기는 한도를 250~450MB 넘겨 쓴다 → 0.5GB
output_margin = 512MB
; 한 파일의 결함이 이보다 많으면 그 파일만 작업 폴더의 임시 SQLite에 넣고 SQL로 정렬·순번을 매긴다(분석 자식 메모리 일정, P19C) [가정] 2만
file_defect_spill_threshold = 20000

[limits]
; 프로젝트 결함 수(P19C). 현재 결함(해결 아님)이 project_defect_warn을 넘으면 관리자 알림과 프로젝트 화면 경고 [가정] 20만
; 반영 뒤 결함이 project_defect_max를 넘길 것이 분명하면(이번에 감지한 결함 수만으로도 넘으면) 분석을 defect_limit_exceeded로 실패(데이터 그대로) [가정] 100만
; 0이면 경고·제한 없음. 결함이 아주 많으면 생성 파일·압축(minified) 파일을 프로젝트 제외 패턴에 넣는다(docs/worker_setup.md "결함이 아주 많은 프로젝트")
project_defect_warn = 200000
project_defect_max = 1000000

[worker]
; CLI 워커 tools/worker.php (명세 5.2, 19.8, P14). 기동 방법은 docs/worker_setup.md
; 대기열 확인 간격
poll_interval = 1s
; 취소 요청 확인 간격(약 1초) (명세 5.4)
cancel_check_interval = 1s
; 생존 신호(data/work/worker/heartbeat.json) 기록 간격 [가정] 10초
heartbeat_interval = 10s
; 생존 신호가 이 시간 이상 끊기고 워커 잠금도 풀려 있으면 그 워커의 작업을 되돌린다 [가정] 3분
heartbeat_stale = 3m
; 생존 신호 파일이 없을 때(워커 없이 process_upload.php를 쓴 경우)의 안전망: 해제 중 24시간 (P13)
stale_safety = 24h
; 업로드 후처리(조립·해제) 동시 처리 수. 분석 동시 실행 수와 따로 센다 [가정] 1
upload_concurrency = 1
; 조립·해제 한 건의 상한(분석 타임아웃과 별도) [가정] 2시간. P13 실측: 항목 100만 개 해제 216초(Windows)
extract_timeout = 2h
; 서비스 관리자(NSSM·작업 스케줄러·systemd)가 워커를 자동으로 다시 띄우는지 (P20A, docs/worker_setup.md)
; true: 관리자 화면 "재시작 요청" = 정지 신호(종료 코드 75) 후 서비스 관리자가 다시 띄움. false: 재시작 요청을 막고 "정지 → 시작"으로 안내
supervised = false
; 관리자 화면 "시작" 버튼이 실행하는 고정 명령(사전 등록한 작업을 시작하는 명령 하나). 비우면 버튼을 숨긴다 (P20A)
; 셸을 거치지 않고 인자 배열로 실행한다. 첫 단어는 절대 경로이거나 schtasks·systemctl·sudo 중 하나. 따옴표로 인자를 묶을 수 있다
; 예: Windows  start_command = "schtasks /run /tn PJGuardianWorker"
;     Linux    start_command = "sudo -n systemctl start pjguardian-worker"   (sudoers에 이 명령 하나만 허용)
start_command = ""
; 시작 명령 실행 제한 시간 [가정] 10초
start_timeout = 10s
; 관리 작업(도구 재검증, 지금 정리 실행, 디스크 사용량 계산) 한 건의 상한 [가정] 1시간
admin_task_timeout = 1h
; 관리자 화면 로그 보기: 마지막 줄 수
log_tail_lines = 200

[tools]
; ESLint 실행용 Node.js 경로. 비우면 PATH에서 찾는다 (명세 12, 19.10)
node_path = ""
; Node.js 최소 버전. ESLint 10 요구: ^20.19.0 || ^22.13.0 || >=24 (명세 19.10) [가정]
node_min_version = "20.19.0"
; 관리자 화면에서 올리는 도구 설치 패키지(zip) 크기 한도 (P20A)
package_max_size = 1GB
; 설치하지 않은(또는 설치가 끝난) 스테이징을 지우기까지의 기간. 정리 작업(tools/cleanup.php)이 지운다 [가정] 7일
staging_retention = 7d

[auth]
; 비밀번호 최소 길이 8자 (명세 3, 로컬 계정만 적용 19.2)
password_min_length = 8
; 대문자·소문자·숫자·특수문자 중 최소 문자 종류 2종 (명세 3)
password_min_char_classes = 2
; 계정 잠금: 연속 5회 실패 시 15분 (명세 3)
lockout_max_failures = 5
lockout_duration = 15m
; IP 제한: 10분 내 20회 이상 실패 시 15분 차단 (명세 3, 19.5)
ip_failure_window = 10m
ip_max_failures = 20
ip_block_duration = 15m
; 세션 비활동 만료 30분 (명세 3)
session_idle = 30m
; 관리자 발급 임시 비밀번호 만료 24시간 (명세 3, 13, 19.2)
temp_password_expiry = 24h
; 세션 마지막 활동 시각 갱신 간격. 이 시간 안의 요청은 DB 쓰기를 건너뛴다(만료 판정 오차도 이만큼) (P10) [가정] 60초
session_touch_interval = 60s
; bcrypt 비용 (명세 3) [가정] 11. 운영은 10 이상
bcrypt_cost = 11
; 외부 인증 첫 로그인의 승인 대기 계정(P28B): 대기·거절 계정 상한(넘으면 새 요청 거부, 관리자 알림 하루 1회), 보관 기간(지나면 정리 작업이 지움) [가정]
pending_max = 50
pending_retention_days = 30

[backup]
; 백업·복원 (P27B, 명세 14·19.3·19.4, docs/backup_restore.md). dir 등 대부분은 관리자 "시스템 관리 > 설정 관리"(묶음 "백업")에서 바꾼다 — 화면 값은 settings.local.ini
; 백업 폴더: 프로젝트 루트 기준 상대 경로 또는 절대·UNC 경로. 기본 프로젝트 바로 아래 backups/(사용자 결정 2026-10-08, 웹 루트 public/ 밖)
; 운영에서는 운영 디스크와 다른 디스크·네트워크 드라이브로 바꾼다(명세 19.4 — 같은 디스크면 화면에 경고)
dir = backups
; 자동 백업 켜기/끄기 (P27E). 끄면 워커가 자동 백업·보관 정리·실패 알림을 하지 않는다(수동 백업·명령줄은 그대로)
enabled = true
; 주기: daily(매일) | weekly(매주, weekly_day) | monthly(매월, monthly_day) (P27E, 명세 14·19.4 기본 매일)
schedule_mode = daily
; 실행 시각(표시 시간대 HH:MM) — 세 방식 모두 이 시각. 키 이름은 P27B 호환으로 daily_at [가정] 02:30
daily_at = 02:30
; 매주 요일: mon tue wed thu fri sat sun [가정] sun
weekly_day = sun
; 매월 날짜: 1~31 또는 last(말일). 그 달에 없는 날짜는 그 달 마지막 날 [가정] 1
monthly_day = 1
; 보관 60일 (명세 14, 19.4). 오래돼도 최근 retention_min_count개는 지우지 않는다 [가정] 3
retention_days = 60
retention_min_count = 3
; 일반 백업 보관 개수 상한(0 = 제한 없음, P27E). 최소 보관 개수 이상이어야 한다 [가정] 0
retention_max_count = 0
; 복원 직전(pre_restore)·업그레이드 직전(pre_upgrade) 백업 보관 [가정] 30일
safety_retention_days = 30
; 화면 "묶음 올리기" 한도(MB) [가정] 2048
upload_max_mb = 2048
; 복원 전 진행 중인 분석을 기다리는 최대 시간(분) [가정] 30
restore_wait_max_minutes = 30
; 복원 리허설 주기(일, 명세 19.4 분기 1회) — 넘으면 관리자 알림
rehearsal_interval_days = 90
; 마지막 성공 백업이 이보다 오래되면 경고(시간) [가정] 36 — 매주는 8일, 매월은 33일보다 작으면 그 값으로(P27E)
backup_stale_hours = 36
; 설정 복원 때 기본 체크 해제할 PC 고유 config.ini 키("섹션.*"는 섹션 전체)
config_machine_keys = app.base_url, paths.*, tools.node_path, repository.ca_cert_file, ldap.ca_cert_file, ldap.server_url, smtp.host, smtp.port, health.allowed_ips, security.trusted_proxies, monitoring.tls_cert_file, worker.start_command, backup.dir
; 유지보수 플래그가 이보다 오래 남으면 경고(분) [가정] 120
maintenance_stale_minutes = 120
; (P27B 전 키, 호환용 — 읽지 않음) interval = 1d, retention = 60d

[snapshot]
; 전체 코드 스냅샷 보존: 최근 5회 분석 (명세 7, 14)
full_keep_count = 5
; 그보다 오래된 분석: 결함 라인 앞뒤 20줄 발췌 (명세 7)
excerpt_context_lines = 20

[viewer]
; 코드 뷰어 조회 한도 (명세 7, 19.6: 뷰어 열기 2초 이내). 모두 [가정] P17. 키가 없으면 아래 기본값을 쓴다
; 결함 주변 창: 결함 줄 앞뒤 200줄(기본 보기). "전체 파일"을 고르면 파일 전체
code_window_lines = 200
; 한 번에 돌려주는 최대 줄 수. 전체 파일이 이보다 길면 결함 주변 창으로 보여 준다
code_max_lines = 20000
; 한 줄 최대 길이(문자). 넘으면 잘라서 보여 주고 "잘림"을 표시한다(압축된 JS 등)
code_max_line_length = 2000
; 이보다 큰 파일은 뷰어에서 열지 않는다(스냅샷 zip 안의 원본 크기)
code_max_file_size = 20MB

[disk]
; 디스크 사용률 경고 80% (명세 19.3)
warn_percent = 80
; 디스크 사용률 90%에서 신규 업로드·가져오기 차단 (명세 19.3)
block_percent = 90

[repository]
; 저장소 가져오기 타임아웃 30분 (명세 18.3)
fetch_timeout = 30m
; 분석 주기 최소 간격 1일 (명세 18.2)
min_interval = 1d
; 분석 주기 기본값: 0 = 사용 안 함 (명세 18.2). 권장 주기는 7d(1주일)이며 가이드에 안내한다
default_interval = 0
; 한 회차 안에서 저장소 접속 연속 실패 허용 횟수 3회. 초과 시 다음 주기에 재수행 (명세 18.3).
; 주기 분석의 가져오기가 일시적 오류(접속 불가·시간 초과·분류 불가)로 실패하면 같은 분석을 재시도 대기로 되돌린다(P26)
connect_max_attempts = 3
; [가정] 접속 재시도 간격 5분 (부록 확인 필요 항목, 명세 본문에 없음). 기다리는 동안 워커는 다른 작업을 처리한다 (P26)
connect_retry_interval = 5m
; 사내 CA 인증서 경로(Git, Perforce 검증용). 검증 비활성화는 허용하지 않는다 (명세 19.7)
ca_cert_file = ""
; 연결 테스트(관리자, 웹 요청에서 git ls-remote·p4 확인) 시간 상한 30초, 사용자당 분당 6회 [가정] (P25)
test_timeout = 30s
test_per_minute = 6
; 개발용 예외: true면 허용 호스트에 등록한 loopback(127.0.0.1, ::1, localhost)에도 접속한다(시험용 로컬 저장소). 운영은 false. 켜면 로그에 경고 (P25)
allow_local_dev = false
; 허용 호스트 연결 테스트(관리자, 웹 요청 안에서 이름 풀이·TCP·TLS·HTTP 상태 줄만 — 저장소·자격 증명 없음) (P26B)
; 전체 테스트 한 번에 최대 20개(나머지는 안내), 단계별 시간 상한 TCP 5초·TLS 5초·HTTP 10초. 신뢰 검증은 ca_cert_file(있으면)
; 인증서 만료 경고는 [notification] cert_expiry_warn(30일)을 따른다
host_test_max = 20
host_test_tcp_timeout = 5s
host_test_tls_timeout = 5s
host_test_http_timeout = 10s

[scheduler]
; 주기 분석 스케줄러 = 워커의 주기 작업(새 프로세스 없음). 도래 확인 간격 1분(최소 10초) (명세 18.2, P26)
tick_seconds = 60s
; 한 번의 확인에서 처리하는 도래 프로젝트 수 상한(남으면 다음 확인에) (P26)
max_per_tick = 50

[log]
; 로그 레벨: ERROR, WARN, INFO (기본 INFO) (명세 19.7)
level = "INFO"
; 에러·접근 로그 보존 30일 (명세 14)
error_access_retention = 30d
; 감사 로그 보존 90일 (명세 10, 14, 19.7). 정리 작업(tools/cleanup.php)이 매일 지우고 해시 체인 기준점을 옮긴다(P30). 화면: 시스템 관리 > 설정 관리 > 보존 기간
audit_retention = 90d
; [가정] 감사 로그 정리가 한 트랜잭션에서 지울 최대 행 수 — 쓰기 잠금을 짧게 (P30)
audit_purge_batch = 5000
; 감사 로그 최신 체인 해시를 DB 밖(logs_dir/audit-anchor.jsonl, 덧붙이기만)에 남기는 간격(P31, 워커). 무결성 검사·모니터링이 DB와 대조한다. 1m~1d
audit_anchor_interval = 1h

[notification]
; 앱 내 알림 보존 30일 (명세 17). P24부터 쓰지 않는다: 보관 기간은 관리자 화면(시스템 관리 > 설정 관리 > 알림 탭의 알림 보관 기간, app_settings
; notifications.retain_read_days 7일·retain_unread_days 30일·max_per_user 1000)에서 정한다. 기존 설정 파일과 호환되도록 키는 남겨 둔다
retention = 30d
; [P30B부터 읽지 않음 — [alert_mail] resend_interval] 관리자 장애 이메일: 같은 이벤트는 1시간에 한 번만 발송 (명세 19.3)
admin_alert_dedupe = 1h
; HTTPS 인증서 만료 경고 시작: 만료 30일 전 (명세 19.7)
cert_expiry_warn = 30d
; [P30B부터 읽지 않음 — [alert_mail] recipients] 장애 알림 받을 관리자 이메일 주소(쉼표 구분) (명세 19.3)
admin_emails = ""

[smtp]
; [P30B부터 읽지 않음 — 아래 [alert_mail]을 쓴다. 기존 설정 파일과 호환되도록 키만 남겨 둔다] 관리자 장애 알림용 SMTP (명세 19.3)
host = ""
port = ""
; tls: none | starttls | tls (비우면 미설정)  [가정] 선택지 이름
tls = ""
username = ""

[alert_mail]
; P30B 관리자 장애 이메일(명세 19.3, docs/monitoring.md 4절). 관리자 화면 "시스템 관리 > 설정 관리 > 관리자 이메일"에서 바꾼다(화면 값은 settings.local.ini).
; SMTP 비밀번호는 설정 파일에 두지 않는다 — 같은 화면에서 저장하면 암호화해 DB(app_secrets)에 둔다(키는 secrets.ini encryption_key).
; 발송은 워커의 주기 판정에서만 한다(웹 요청은 보내지 않음). 워커가 멈추면 메일도 가지 않는다 — 외부 감시는 /health로.
enabled = false
; SMTP 서버 이름 또는 IP(스킴·경로 없이). 사설망 중계 허용
smtp_host = ""
smtp_port = 587
; none(평문 — localhost·사설망 중계용) | starttls | smtps. 인증서 검증은 늘 켜져 있다(사내 CA는 PHP/OS 신뢰 저장소에 추가)
smtp_tls = starttls
; none | login
smtp_auth = login
smtp_user = ""
from_address = ""
from_name = "PJGuardian"
; 받는 사람(쉼표, 최대 20). 비우면 활성 admin 계정의 이메일 전체
recipients = ""
; 메일 언어: ko | en
language = ko
; 보낼 사건 종류(쉼표): worker_down, queue_stalled, disk, backup, tool, repo, cert
events = "worker_down, queue_stalled, disk, backup, tool, repo, cert"
; 같은 사건이 이어질 때 다시 보내는 간격(10m~24h, 명세 19.3: 1시간 1회)
resend_interval = 1h
; 사건이 풀리면 복구 메일 한 통
recovery = true
; 아래는 화면 밖(config.ini에서만): 연결 시간 상한·전체 시간 상한, 시험 발송 제한(사용자당 분당·전체 시간당), 해소된 사건 상태 보관
connect_timeout = 10s
send_timeout = 30s
test_per_minute = 3
test_per_hour = 20
state_retention = 30d

[ldap]
; LDAP/AD 로그인(P28B, 명세 19.2, docs/auth_ldap.md). 관리자 화면 "시스템 관리 > 설정 관리 > LDAP/AD"에서 바꾼다(화면 값은 settings.local.ini).
; 검색 계정 비밀번호는 설정 파일에 두지 않는다 — 같은 화면에서 저장하면 암호화해 DB(app_secrets)에 둔다(키는 secrets.ini encryption_key)
enabled = false
; 서버 1~3개(쉼표, 앞에서부터 — 연결 실패만 다음 서버로). LDAPS 권장(예: ldaps://ldap.example.local:636). ldap://는 use_starttls = true여야 한다
servers = ""
use_starttls = false
; 사내 CA 인증서(PEM) 절대 경로. 비우면 운영체제 신뢰 목록. 인증서 검증을 끄는 설정은 없다 (명세 19.7)
ca_file = ""
base_dn = ""
; 사용자 검색 필터: %s(로그인 ID, 이스케이프) 정확히 하나. OpenLDAP 예: (&(objectClass=inetOrgPerson)(uid=%s))
user_filter = "(&(objectClass=user)(sAMAccountName=%s))"
bind_dn = ""
; 속성 매핑(AD 기본값). OpenLDAP: attr_login = uid, attr_id = entryUUID, attr_disabled = ""
attr_login = sAMAccountName
attr_name = displayName
attr_email = mail
; 안정 식별자(이름이 바뀌어도 그대로 — DN은 쓰지 않음)
attr_id = objectGUID
; 비활성 표시(AD userAccountControl — 비트 2면 거부). 비우면 검사 안 함
attr_disabled = ""
connect_timeout = 5s
search_timeout = 10s
; 예전 키(P28B 전 호환 — 새 키가 비었을 때만 쓴다): server_url → servers, attr_user_id → attr_login, ca_cert_file → ca_file
server_url = ""
attr_user_id = ""
ca_cert_file = ""
; 연결 테스트(관리자, 웹 요청에서 git ls-remote·p4 확인) 시간 상한 30초, 사용자당 분당 6회 [가정] (P25)
test_timeout = 30s
test_per_minute = 6
; 개발용 예외: true면 허용 호스트에 등록한 loopback(127.0.0.1, ::1, localhost)에도 접속한다(시험용 로컬 저장소). 운영은 false. 켜면 로그에 경고 (P25)
allow_local_dev = false

[oidc]
; SSO 로그인 — OpenID Connect(Authorization Code + PKCE S256) (명세 19.2, P28C, docs/auth_oidc.md)
; 화면 "시스템 관리 > 설정 관리 > SSO(OIDC)"에서 바꾼다(재시작 없음). 제공자는 하나만. 첫 로그인은 승인 대기 계정(P28B 공통 규칙)
; 클라이언트 비밀은 이 파일이 아니라 화면에서 암호화 저장(app_secrets oidc.client_secret, 마이그레이션 027 필요)
enabled = false
; 발급자 URL(https, 디스커버리 문서의 issuer와 정확히 같아야 함 — 끝의 / 포함 여부까지)
issuer = ""
client_id = ""
; 토큰 요청 클라이언트 인증: basic(client_secret_basic) | post(client_secret_post) | none(공개 클라이언트 + PKCE)
client_auth = basic
; 요청 scope(공백 구분, openid 필수). 리프레시 토큰(offline_access)은 쓰지 않는다
scopes = "openid profile email"
; 로그인 ID로 쓸 클레임(X06 규칙). email_localpart = 검증된 email의 @ 앞부분. 계정 식별은 발급자 + sub
claim_login = preferred_username
; 표시 이름 클레임(승인 대기 계정을 만들 때 한 번만)
claim_name = name
; ID 토큰에 이름·이메일이 없는 제공자만 true(UserInfo 한 번 더 호출, 토큰은 저장하지 않음)
use_userinfo = false
; ID 토큰 서명 알고리즘(RS256·ES256 중에서만 — none·HS*는 받지 않음)
allowed_algs = "RS256, ES256"
; 로그인 화면 단추 문구(40자 이내, 비우면 화면 언어로 "SSO로 로그인")
button_label = ""
; true면 OIDC 계정 로그아웃 뒤 제공자 로그아웃 화면으로(post_logout_redirect_uri = <공개 주소>/login?logged_out=1 등록). 기본 false = 앱 세션만 [가정] (P28C)
provider_logout = false
; 리다이렉트 URI(<공개 주소>/auth/oidc/callback)를 만들 공개 주소. 비우면 app.base_url. Host 헤더는 쓰지 않는다. https(루프백 개발 주소만 http)
redirect_base = ""
; 디스커버리·JWKS 캐시 1시간, 제공자에 닿지 않을 때 오래된 캐시를 더 쓰는 상한 1시간(최대 24시간) [가정] (P28C)
jwks_cache_ttl = 1h
jwks_stale_max = 1h
; 로그인 시작 요청 IP당 분당 20회, 연결 시험 관리자당 분당 6회 [가정] (P28C)
start_per_minute = 20
test_per_minute = 6
; 개발용 예외: true면 루프백 주소의 IdP에도 접속(시험용). 운영은 false (P28C)
allow_local_dev = false

[saml]
; SSO 로그인 — SAML 2.0 SP(SP 시작만: HTTP-Redirect 요청 → HTTP-POST 응답) (명세 19.2, P28D, docs/auth_saml.md)
; 화면 "시스템 관리 > 설정 관리 > SSO(SAML)"에서 바꾼다(재시작 없음). 제공자는 하나만. 서명 검증은 onelogin/php-saml(Composer, vendor/)
; 공개 주소(ACS·SP EntityID)는 OIDC와 같은 규칙: oidc.redirect_base, 비우면 app.base_url. SP 키는 화면에서 생성(app_secrets, 마이그레이션 027)
enabled = false
idp_entity_id = ""
; IdP SSO 주소(HTTP-Redirect, https)
idp_sso_url = ""
; IdP 서명 인증서(PEM 본문 base64 한 줄), 롤오버용 다음 인증서 — 둘 중 하나로 서명돼 있으면 통과
idp_cert = ""
idp_cert_next = ""
; SP EntityID(비우면 <공개 주소>/auth/saml/metadata)
sp_entity_id = ""
; 요청할 NameID 형식: persistent | unspecified | emailAddress | transient(식별자가 nameid면 쓸 수 없음)
name_id_format = persistent
; 계정 식별자: nameid 또는 바뀌지 않는 속성 이름(URI 가능)
id_source = nameid
; 로그인 ID·표시 이름·이메일 속성(Name 또는 FriendlyName, URI 가능)
attr_login = ""
attr_name = ""
attr_email = ""
; 요청 서명·암호화된 어서션 요구(둘 다 SP 키 필요)
sign_requests = false
want_encrypted = false
; 로그인 화면 단추 문구(40자 이내, 비우면 "SAML로 로그인")
button_label = ""
; 로그인 시작 IP당 분당 20회, 설정 확인·메타데이터 가져오기 관리자당 분당 6회 [가정] (P28D)
start_per_minute = 20
test_per_minute = 6
; 개발용 예외: true면 루프백 주소의 IdP에도 접속(메타데이터 가져오기·설정 확인). 운영은 false (P28D)
allow_local_dev = false

[health]
; /health 엔드포인트 허용 IP(쉼표 구분, CIDR 가능) (명세 19.3)
; [가정] 명세에 기본값이 없어 비워 둔다. 빈 값이면 모든 접근을 거부한다(허용 밖·빈 목록은 없는 주소와 같은 404). 판정은 접속 주소(REMOTE_ADDR)만 —
; X-Forwarded-For 같은 헤더는 믿지 않는다(앞단 프록시를 쓰면 프록시 주소를 넣고 프록시에서 접근을 막는다, docs/monitoring.md). 화면: 설정 관리 > 모니터링
allowed_ips = ""
; [가정] 허용 IP당 분당 호출 수(넘으면 429) (P30)
per_minute = 60
; [가정] 같은 응답을 다시 쓰는 시간(폭주 방지) (P30)
cache = 5s

[monitoring]
; 시스템 모니터링·장애 판정 (명세 14, 19.3, P30, docs/monitoring.md)
; [가정] 큐 정체: 워커가 살아 있고 빈 자리가 있는데 시작할 수 있는 가장 오래된 대기 분석이 이 시간 넘게 시작되지 않음. 화면: 설정 관리 > 모니터링
queue_stall = 15m
; [가정] 판정 결과 캐시(관리자 배너·화면). 워커도 이 간격으로 판정해 상태 변화를 경고 로그에 남긴다
cache = 30s
; [가정] 같은 경고가 이어질 때 경고 로그를 다시 쓰는 간격(상태가 바뀌면 바로)
log_repeat = 1h
; [가정] 화면 자동 갱신 간격(탭이 보일 때만)
refresh = 30s
; [가정] 최근 실패 분석 카드 건수
recent_failures = 10
; [가정] 저장소 가져오기 연속 실패 경고: 주기 분석이 이 횟수 이상 연속 실패한 프로젝트가 있으면
repo_failures = 2
; HTTPS 인증서 만료일 확인용 — 웹 서버(Apache)가 쓰는 서버 인증서 파일(PEM, 절대 경로). 비우면 화면에 "확인 불가"(명세 19.7)
; 예: C:/xampp/apache/conf/ssl.crt/server.crt, /etc/ssl/certs/pjguardian.crt
tls_cert_file = ""

[ui]
; 결함 목록 페이지 크기 50건 (명세 6.4). 목록 API의 기본 size이기도 하다(명세 19.7)
defect_page_size = 50
; 목록 API의 size 최대값 [가정] 200 (P07)
page_size_max = 200
; 결함 일괄 변경(담당자·심각도·상태) 한 번에 처리하는 최대 건수 [가정] 500 (P18). 화면은 현재 페이지만 선택하므로 보통 페이지 크기 이하
bulk_update_max = 500
; 대시보드 추이 차트: 최근 성공 분석 10건 (명세 9)
dashboard_trend_count = 10
; 대시보드 규칙별·파일별 상위 10개 (명세 9)
dashboard_top_n = 10
; 히스토리 분석 이력 한 쪽 기본 20건, 최대 100건 [가정] (P21)
history_page_size = 20
history_page_size_max = 100
; 상단 알림 아이콘의 안 읽은 개수 갱신 주기(초, P24). 탭이 보이는 동안만 요청하고 숨기면 멈춘다. 최소 15 [가정] 60
notification_poll_seconds = 60

[history]
; 히스토리(P21 예정): 두 Run의 분석 대상 파일 수가 이 비율 이상 다르면 "분석 범위가 달라졌습니다"를 표시 [가정] 0.5 (P20R에서 추가)
scope_change_ratio = 0.5

[runs]
; Run 상세 보관(P21B, docs/architecture.md 35절): 프로젝트마다 상세(과거 Run 보기 run=N)를 유지할 최근 Run 수. 넘으면 워커가 분석 사이에
; 가장 오래된 Run부터 상세를 지운다(Run 번호·날짜·건수·도구 버전·히스토리 표·결함 이력은 남음, 최신 Run은 지우지 않음).
; 0이면 자동 삭제 끔, 1~2는 거부. admin은 "시스템 관리 > Run 관리"에서 골라 지울 수 있다 [가정] 15
detail_keep = 15
; 워커가 한 번(분석 하나가 끝난 뒤)에 지울 최대 Run 수. 남으면 다음 분석 뒤에 이어서 [가정] 20
retention_batch = 20

[severity]
; 규칙 기본 심각도(P21S, 명세 6.2): 분석에서 새로 감지한 결함에 규칙별 기본 심각도(resources/severity/*.json, docs/severity_mapping.md)를 넣는다.
; 이미 있는 결함·사람이 바꾼 심각도는 바꾸지 않는다. false면 신규 결함은 not_defined(이전 동작). 기존 결함 채움은 tools/severity_apply.php [가정] true
auto_assign = true

[rules]
; 규칙 설명(P22, docs/rules.md): 워커가 시작할 때와 load_interval마다 규칙 데이터 적재를 요청한다(활성 도구 버전·설치 버전·심각도 매핑이
; 그대로면 아무것도 바꾸지 않음). 끄면 tools/rules_load.php --apply 또는 관리자 화면의 "규칙 데이터 다시 불러오기"로만 적재한다 [가정] true, 1h
auto_load = true
load_interval = 1h
; 관리자 규칙 켜기·끄기(P22B, docs/rules.md 5절): 도구별 "모두 기본값으로 되돌리기"가 한 번에 되돌리는 최대 건수.
; 넘으면 남은 건수를 알려 주고 다시 누르게 한다 [가정] 1000(ruff 규칙 수 ~970보다 크다)
override_reset_max = 1000
; 규칙 목록 일괄 변경(P22C): 한 번에 바꿀 수 있는 대상 규칙 수 상한. 넘으면 미리보기가 거부하고 검색 조건을 좁히라고 안내한다(잘라서 적용하지 않음)
; [가정] 1000(ruff 규칙 수 ~970 — 한 탭의 규칙 전체를 한 번에 다룰 수 있게)
bulk_max = 1000

[export]
; 내보내기(P23, 명세 14 — 결함 목록·내게 지정된 결함·규칙 설명 목록 → CSV·Excel). 운영 조정은 docs/export.md
; 한 번에 내보낼 수 있는 행 수 상한. 넘으면 파일을 만들지 않고 건수·상한을 알려 거부한다(잘라서 주지 않음) [가정] 50000, 1~200000
max_rows = 50000
; 동시에 처리하는 내보내기 수(서버 전체)와 사용자당 수. 넘으면 429 export_busy [가정] 2, 1
max_concurrent = 2
max_per_user = 1
; 파일 하나를 만드는 시간·PHP 메모리 상한. 넘으면 중단하고 임시 파일을 지운다 [가정] 60초, 128MB
timeout_seconds = 60
memory_limit = 128MB

[dashboard]
; 대시보드 집계 캐시 시간 [가정] 60초. 0이면 끈다. 분석 반영·결함 변경·접근 범위 변경은 TTL과 관계없이 다음 요청에 반영된다 (P20)
cache_ttl = 60s
