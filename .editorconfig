root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,mjs,cjs,yml,yaml,css,html}]
indent_size = 2

[{package.json,package-lock.json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[{SHA256SUMS,*.zip,*.png,*.svg}]
insert_final_newline = unset
trim_trailing_whitespace = unset
